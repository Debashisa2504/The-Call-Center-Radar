# ── PostgreSQL (required) ─────────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.postgres.database.azure.com:5432/callradar?sslmode=require
INGEST_WORKERS=2

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Model deployment names (must match your Azure deployments) ────────────────
# Chat / analysis model
ANALYSIS_MODEL=gpt-4o
# Embedding model deployment
EMBED_MODEL=text-embedding-3-large
# Whisper deployment — change to your deployment name if different
WHISPER_MODEL=whisper

# ── Ghost resolution ──────────────────────────────────────────────────────────
GHOST_WINDOW_MIN=30

# ── Trend clustering ──────────────────────────────────────────────────────────
TREND_CLUSTERS=12

# ── Contextual retrieval ──────────────────────────────────────────────────────
CONTEXT_ENRICHMENT=true
CONTEXT_LLM_ENRICHMENT=false

# ── Cross-encoder reranker ────────────────────────────────────────────────────
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
RERANK_TOP_K=10
DEDUP_THRESHOLD=0.85

# ── Chunking constants ────────────────────────────────────────────────────────
CHUNK_MAX_UTTERANCES=15
CHUNK_MAX_SPAN_SEC=60
CHUNK_MAX_WORDS=400
CHUNK_SOFT_MIN_UTTERANCES=3
CHUNK_SOFT_MIN_SPAN_SEC=10
CHUNK_PAUSE_GAP_SEC=3.0
CHUNK_OVERLAP_WORDS=40
CHUNK_MERGE_GAP_SEC=1.0

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
